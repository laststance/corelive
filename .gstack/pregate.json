      "scripts/typescript-toolchain.test.ts"
    ],
    "packages/eslint-plugin-dslint/vitest.config.ts": [
      "packages/eslint-plugin-dslint/tests/rules/token-only.test.ts"
    ],
    "tsconfig.json": [
      "scripts/typescript-toolchain.test.ts"
    ],
    "vitest.config.tools.ts": [
      "scripts/typescript-toolchain.test.ts",
      "scripts/security-patches.test.ts"
    ],
    "packages/eslint-plugin-dslint/**": [
      "packages/eslint-plugin-dslint/tests/rules/token-only.test.ts",
      "packages/eslint-plugin-dslint/tests/rules/class-visitors.test.ts",
      "packages/eslint-plugin-dslint/tests/cli/css-parser.test.ts",
      "packages/eslint-plugin-dslint/tests/utils/quoted-config-keys.test.ts",
      "packages/eslint-plugin-dslint/tests/utils/parse-config-string-entries.test.ts"
    ]
  },
  "guards": [
    {
      "id": "workspace-boundaries",
      "when": [
        "scripts/check-workspace.mjs",
        "packages/**/package.json",
        "pnpm-lock.yaml"
      ],
      "command": "pnpm check:workspace",
      "fix": "Keep package exports, workspace dependencies and pinned runtime boundaries consistent."
    },
    {
      "id": "fallow-configuration",
      "when": [
        ".fallowrc.jsonc"
      ],
      "command": "pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:health",
      "fix": "Resolve reported code health findings without weakening thresholds."
    }
  ],
  "runner": "pnpm test:selected {files}"
}
