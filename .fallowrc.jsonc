{
  "$schema": "./node_modules/fallow/schema.json",
  // These roots are launched by subprocesses, electron-builder, or separate Vitest configs.
  // The shadcn catalog stays installed even when the app does not import every primitive.
  // Wallaby reads wallaby.conf.js outside the app module graph.
  "entry": [
    "apps/desktop/electron/dev-runner.ts",
    "apps/desktop/scripts/after-build.js",
    // Run by .github/workflows/db-migrate.yml around `drizzle-kit migrate`, not by a package script.
    "apps/web/scripts/baseline-drizzle-migrations.mjs",
    "apps/web/src/components/ui/**/*.tsx",
    "apps/web/wallaby.conf.js",
  ],
  "framework": [
    {
      "name": "corelive-electron-tests",
      "enablers": ["vitest"],
      "entryPoints": [
        "apps/desktop/electron/**/*.{test,spec}.{ts,mjs}",
        "scripts/**/*.{test,spec}.{ts,mjs}",
        "apps/web/scripts/**/*.{test,spec}.{ts,mjs}",
      ],
      "entryPointRole": "test",
    },
  ],
  // Next.js generates route declarations; theme:generate owns the repeated theme CSS.
  "ignorePatterns": [
    "apps/web/next-env.d.ts",
    "apps/web/src/lib/themes/generated.css",
  ],
  "ignoreDependencies": [
    // Next.js loads the CSS optimizer by name.
    "critters",
    // Explicit packaged dependencies: electron-builder must retain these transitive runtime modules.
    "ms",
    "node-gyp-build",
    "pino-pretty",
    "thread-stream",
    "wrappy",
  ],
  // electron-vite emits these .ts entry points as .cjs; the output is absent in a fresh checkout.
  "ignoreUnresolvedImports": [
    "./SystemTrayManager.cjs",
    "./NotificationManager.cjs",
    "./ShortcutManager.cjs",
    "./AutoUpdater.cjs",
    "./MenuManager.cjs",
    "./SystemIntegrationErrorHandler.cjs",
    "./OAuthManager.cjs",
    "./DeepLinkManager.cjs",
  ],
  // The documented shadcn component catalog intentionally exposes its composition primitives.
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/**",
      "exports": ["*"],
    },
  ],
  "duplicates": {
    // Test cases repeat setup and expected values so each scenario remains readable.
    "ignore": ["**/*.{test,spec}.{ts,tsx,mjs}", "**/__tests__/**"],
  },
  "health": {
    // Match the structural complexity budget used by Skills Desktop.
    "maxCyclomatic": 40,
    "maxCognitive": 40,
    "maxCrap": 120,
    "ignore": [
      "**/*.{test,spec}.{ts,tsx,mjs}",
      "**/__tests__/**",
      "scripts/**",
      "apps/*/scripts/**",
      "apps/web/src/db/seed/*.ts",
    ],
  },
}
