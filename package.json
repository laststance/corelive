{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "minimatch@>=10.0.0 <10.2.6": "10.2.6",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "brace-expansion@>=1 <1.1.21": "1.1.21",
      "brace-expansion@>=2 <2.1.7": "2.1.7",
      "brace-expansion@>=4 <5.0.12": "5.0.12",
      "source-map-js@>=1 <1.2.2": "1.2.2",
      "fast-uri@>=3 <3.1.8": "3.1.8",
      "http-cache-semantics@<=4.2.0": "4.3.0",
      "shell-quote@>=1.8.4 <1.11.0": "1.12.0",
      "sharp@<0.35.5": "0.35.5"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@tailwindcss/oxide",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "sprintf-js@1.1.3": "patches/sprintf-js@1.1.3.patch"
    }
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,ts,jsx,tsx,cjs,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "author": "Ryota Murakami <dojce1048@gmail.com> (https://github.com/ryota-murakami)",
  "name": "corelive-monorepo",
  "description": "CoreLive Dashboard, macOS app and shared packages",
  "devDependencies": {
    "@playwright/cli": "0.1.25",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^10.0.7",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-ts-prefixer": "catalog:",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-you-might-not-need-an-effect": "catalog:",
    "fallow": "3.47.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rimraf": "^6.1.4",
    "sharp": "catalog:",
    "sprintf-js": "^1.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev": "pnpm --filter @corelive/dashboard dev",
    "build": "pnpm --filter @corelive/dashboard build",
    "start": "pnpm --filter @corelive/dashboard start",
    "test": "pnpm --filter @corelive/dashboard test",
    "test:db": "pnpm --filter @corelive/dashboard test:db",
    "test:watch": "pnpm --filter @corelive/dashboard test:watch",
    "test:ui": "pnpm --filter @corelive/dashboard test:ui",
    "coverage:unit:dashboard": "pnpm --filter @corelive/dashboard coverage:unit:dashboard",
    "theme:generate": "pnpm --filter @corelive/dashboard theme:generate",
    "theme:check": "pnpm --filter @corelive/dashboard theme:check",
    "db:generate": "pnpm --filter @corelive/dashboard db:generate",
    "db:migrate": "pnpm --filter @corelive/dashboard db:migrate",
    "db:studio": "pnpm --filter @corelive/dashboard db:studio",
    "db:seed": "pnpm --filter @corelive/dashboard db:seed",
    "seed:dev": "pnpm --filter @corelive/dashboard seed:dev",
    "db:reset": "pnpm --filter @corelive/dashboard db:reset",
    "db:truncate": "pnpm --filter @corelive/dashboard db:truncate",
    "test:electron": "pnpm --filter @corelive/desktop test:electron",
    "test:electron:watch": "pnpm --filter @corelive/desktop test:electron:watch",
    "coverage:unit:electron": "pnpm --filter @corelive/desktop coverage:unit:electron",
    "electron": "pnpm --filter @corelive/desktop electron",
    "electron:dev": "pnpm --filter @corelive/desktop electron:dev",
    "electron:build:ts": "pnpm --filter @corelive/desktop electron:build:ts",
    "electron:build:mac": "pnpm --filter @corelive/desktop electron:build:mac",
    "electron:build:dir": "pnpm --filter @corelive/desktop electron:build:dir",
    "electron:publish": "pnpm --filter @corelive/desktop electron:publish",
    "build:icons": "node scripts/build-assets.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "test:tools": "vitest run --config vitest.config.tools.ts",
    "test:selected": "node scripts/pregate-tests.mjs",
    "test:packages": "pnpm --filter @corelive/desktop-contract test && pnpm --filter @corelive/live-editor test",
    "typecheck": "pnpm --filter @corelive/dashboard typecheck && pnpm --filter @corelive/desktop typecheck && pnpm --filter @corelive/desktop-contract typecheck && pnpm --filter @corelive/live-editor typecheck",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --concurrency=2 --max-warnings 0",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix --concurrency=2 --max-warnings 0",
    "coverage:unit": "pnpm coverage:unit:dashboard && pnpm coverage:unit:electron",
    "coverage:all": "pnpm build:assets && pnpm coverage:unit",
    "prettier": "prettier --ignore-unknown --write .",
    "qa:dashboard": "pnpm --filter @corelive/dashboard exec tsx scripts/qa-dashboard.ts",
    "qa:offline-editor": "pnpm --filter @corelive/desktop exec tsx scripts/qa-offline-editor.ts",
    "qa:settings": "pnpm --filter @corelive/desktop exec tsx scripts/qa-settings.ts",
    "benchmark:offline": "pnpm --filter @corelive/desktop exec tsx scripts/benchmark-offline-workspace.ts",
    "qa:browser": "node scripts/qa-browser.mjs",
    "prepare": "husky",
    "setup:env": "node scripts/setup-env.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "fallow:dead-code": "fallow dead-code --fail-on-issues --no-cache",
    "fallow:dupes": "fallow dupes --fail-on-issues --no-cache",
    "fallow:health": "fallow health --complexity --fail-on-issues --no-cache",
    "validate": "pnpm build:assets && concurrently --kill-others-on-fail \"pnpm test\" \"pnpm test:tools\" \"pnpm test:packages\" \"pnpm test:electron\" \"pnpm lint\" \"pnpm build\" \"pnpm electron:build:ts\" \"pnpm typecheck\" \"pnpm theme:check\" \"pnpm check:workspace\" \"pnpm fallow:dead-code\" \"pnpm fallow:dupes\" \"pnpm fallow:health\"",
    "clean": "rimraf apps/web/.next apps/desktop/dist-electron apps/desktop/dist"
  }
}
