    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "svix": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
