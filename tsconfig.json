{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    ".pnpmfile.cjs",
    "scripts/**/*.ts",
    "*.ts",
    "*.js",
    "*.mjs",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs"
  ]
}
