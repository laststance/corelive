{
  "name": "@corelive/desktop",
  "version": "0.24.1",
  "description": "CoreLive macOS desktop wrapper",
  "author": "Ryota Murakami <dojce1048@gmail.com> (https://github.com/ryota-murakami)",
  "homepage": "./",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.cjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ms": "^2.1.3",
    "node-gyp-build": "^4.8.4",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "thread-stream": "catalog:",
    "uiohook-napi": "^1.5.5",
    "wrappy": "^1.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@corelive/desktop-contract": "workspace:*",
    "sharp": "catalog:",
    "dotenv": "catalog:"
  },
  "scripts": {
    "test:electron": "vitest run --config vitest.config.electron.ts",
    "test:electron:watch": "vitest --watch --config vitest.config.electron.ts",
    "coverage:unit:electron": "vitest run --config vitest.config.electron.ts --coverage",
    "electron": "electron .",
    "electron:dev": "node scripts/dev.js",
    "electron:build:ts": "electron-vite build",
    "electron:build:mac": "pnpm electron:build:ts && node ../../scripts/electron-builder.mjs --mac --publish never && node scripts/finalize-mac-release-artifacts.js",
    "electron:build:dir": "pnpm electron:build:ts && node ../../scripts/electron-builder.mjs --dir",
    "electron:publish": "pnpm electron:build:ts && node ../../scripts/electron-builder.mjs --publish=always",
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --concurrency=2 --max-warnings 0",
    "test": "vitest run --config vitest.config.electron.ts",
    "predev": "node ../../scripts/build-assets.mjs",
    "preelectron:dev": "node ../../scripts/build-assets.mjs",
    "preelectron:build:dir": "node ../../scripts/build-assets.mjs",
    "preelectron:build:mac": "node ../../scripts/build-assets.mjs",
    "preelectron:publish": "node ../../scripts/build-assets.mjs && pnpm typecheck && pnpm test"
  },
  "productName": "CoreLive"
}
