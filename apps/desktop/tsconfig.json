{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "electron/**/*.ts",
    "*.ts",
    "*.js",
    "*.mjs",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
